# Database (SQLite by default; swap provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Required in production: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional — enables "Continue with Google" when both are set
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — enables AI analysis; without it Grammaid uses its local heuristic engine
OPENAI_API_KEY=""

# Optional — comma separated emails granted ADMIN on signup (first account is always admin)
ADMIN_EMAILS=""
